---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Find minijobs in Munich - Bar staff, kitchen helpers, delivery, and more' } = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --concrete: #2a2a2a;
        --asphalt: #1a1a1a;
        --paper: #e8e8e8;
        --paper-dark: #d0d0d0;
        --ink: #000000;
        --chalk: #ffffff;
        --graffiti: #ff006e;
        --neon-yellow: #ffff00;
        --border-thick: 4px;
        --border-thin: 2px;
      }

      body {
        font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Arial Black', sans-serif;
        line-height: 1.4;
        color: var(--ink);
        background: var(--paper);
        background-image:
          repeating-linear-gradient(
            0deg,
            transparent,
            transparent 2px,
            rgba(0,0,0,0.03) 2px,
            rgba(0,0,0,0.03) 4px
          );
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .header {
        background: var(--concrete);
        border-bottom: var(--border-thick) solid var(--ink);
        padding: 1.5rem 0;
        position: sticky;
        top: 0;
        z-index: 100;
        box-shadow: 4px 4px 0 rgba(0,0,0,0.3);
      }

      .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--neon-yellow);
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: -0.05em;
        text-shadow: 2px 2px 0 var(--ink);
        transition: all 0.1s;
      }

      .logo:hover {
        transform: translate(-2px, -2px);
        text-shadow: 4px 4px 0 var(--ink);
      }

      .nav {
        display: flex;
        gap: 2rem;
      }

      .nav a {
        color: var(--chalk);
        text-decoration: none;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.875rem;
        letter-spacing: 0.05em;
        border: var(--border-thin) solid transparent;
        padding: 0.5rem 1rem;
        transition: all 0.1s;
      }

      .nav a:hover {
        border-color: var(--graffiti);
        background: var(--graffiti);
        color: var(--chalk);
        transform: translate(-2px, -2px);
        box-shadow: 2px 2px 0 var(--ink);
      }

      main {
        min-height: calc(100vh - 200px);
        padding: 3rem 0;
      }

      footer {
        background: var(--asphalt);
        border-top: var(--border-thick) solid var(--ink);
        padding: 2rem 0;
        margin-top: 4rem;
      }

      .footer-content {
        text-align: center;
        color: var(--paper-dark);
        font-size: 0.75rem;
        font-family: 'Space Mono', monospace;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      /* Mobile-first responsive design */
      @media (max-width: 768px) {
        .container {
          padding: 0 1rem;
        }

        .header-content {
          flex-direction: column;
          gap: 1rem;
        }

        .logo {
          font-size: 1.5rem;
        }

        .nav {
          gap: 0.5rem;
          width: 100%;
        }

        .nav a {
          flex: 1;
          text-align: center;
          font-size: 0.75rem;
          padding: 0.5rem;
        }
      }
    </style>
  </head>
  <body>
    <header class="header">
      <div class="container">
        <div class="header-content">
          <a href="/" class="logo">MUNICH JOBS</a>
          <nav class="nav">
            <a href="/">Find Work</a>
            <a href="/about">Info</a>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container">
        <div class="footer-content">
          <p>&copy; {new Date().getFullYear()} Munich Minijobs. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
