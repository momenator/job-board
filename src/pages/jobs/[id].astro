---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getJobByID, getWhatsAppLink } from '../../lib/payload';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/');
}

let job;
let error = null;

try {
  job = await getJobByID(id);
} catch (e) {
  error = e instanceof Error ? e.message : 'Job not found';
}

if (error || !job) {
  return Astro.redirect('/');
}

const jobTypeLabels: Record<string, string> = {
  bar: '🍺 Bar Staff',
  kitchen: '👨‍🍳 Kitchen Helper',
  delivery: '🚴 Delivery',
  cleaning: '🧹 Cleaning',
  warehouse: '📦 Warehouse',
  event: '🎉 Event Staff',
  other: '💼 Other',
};

const jobTypeLabel = jobTypeLabels[job.jobType as string] || job.jobType;

// Format date
const createdDate = new Date(job.createdAt);
const formattedDate = createdDate.toLocaleDateString('de-DE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const whatsappLink = getWhatsAppLink(job.contactWhatsApp, job.title);

// Simple function to render rich text (Slate format)
function renderRichText(content: any): string {
  if (!content || !Array.isArray(content)) return '';

  return content.map((node: any) => {
    if (node.type === 'paragraph' || !node.type) {
      const text = node.children?.map((child: any) => child.text || '').join('') || '';
      return `<p>${text}</p>`;
    }
    if (node.type === 'ul') {
      const items = node.children?.map((item: any) => {
        const text = item.children?.[0]?.children?.map((child: any) => child.text || '').join('') || '';
        return `<li>${text}</li>`;
      }).join('') || '';
      return `<ul>${items}</ul>`;
    }
    return '';
  }).join('');
}

const descriptionHTML = renderRichText(job.description);
---

<BaseLayout title={`${job.title} - Munich Minijobs`} description={`${job.title} in ${job.district}. €${job.hourlyRate}/hr, ${job.hoursPerWeek}`}>
  <div class="container">
    <a href="/" class="back-link">← Back to all jobs</a>

    <article class="job-detail">
      <header class="job-header">
        <div class="job-header-content">
          <span class="job-type-badge">{jobTypeLabel}</span>
          <h1 class="job-title">{job.title}</h1>
          <div class="job-meta">
            <span class="meta-item">📍 {job.district}</span>
            <span class="meta-item">💰 €{job.hourlyRate}/Std</span>
            <span class="meta-item">⏰ {job.hoursPerWeek}</span>
          </div>
          <p class="job-date">Posted on {formattedDate}</p>
        </div>
      </header>

      <div class="job-content">
        <section class="job-section">
          <h2>Job Description</h2>
          <div class="description" set:html={descriptionHTML}></div>
        </section>

        {job.address && (
          <section class="job-section">
            <h2>Location</h2>
            <p class="address">📍 {job.address}</p>
          </section>
        )}

        <section class="job-section">
          <h2>Compensation</h2>
          <div class="compensation">
            <p><strong>Hourly Rate:</strong> €{job.hourlyRate}</p>
            <p><strong>Hours per Week:</strong> {job.hoursPerWeek}</p>
          </div>
        </section>

        <section class="job-section apply-section">
          <h2>Apply Now</h2>
          <p class="apply-text">Interested? Contact us directly via WhatsApp!</p>
          <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="whatsapp-button">
            💬 Apply via WhatsApp
          </a>
          {job.contactEmail && (
            <p class="email-contact">
              Or email: <a href={`mailto:${job.contactEmail}`}>{job.contactEmail}</a>
            </p>
          )}
        </section>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    color: var(--primary);
    text-decoration: none;
    margin-bottom: 2rem;
    font-weight: 500;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .job-detail {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .job-header {
    background: var(--bg-gray);
    border-bottom: 1px solid var(--border);
    padding: 2rem;
  }

  .job-type-badge {
    display: inline-block;
    background: var(--primary);
    color: white;
    padding: 0.375rem 1rem;
    border-radius: 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .job-title {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .job-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .meta-item {
    font-size: 1rem;
    color: var(--text);
    font-weight: 500;
  }

  .job-date {
    color: var(--text-light);
    font-size: 0.875rem;
  }

  .job-content {
    padding: 2rem;
  }

  .job-section {
    margin-bottom: 2rem;
  }

  .job-section:last-child {
    margin-bottom: 0;
  }

  .job-section h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .description :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .description :global(ul) {
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .description :global(li) {
    margin-bottom: 0.5rem;
  }

  .address {
    font-size: 1.125rem;
  }

  .compensation p {
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
  }

  .apply-section {
    background: var(--bg-gray);
    padding: 2rem;
    border-radius: 0.5rem;
    text-align: center;
  }

  .apply-text {
    margin-bottom: 1.5rem;
    font-size: 1.125rem;
    color: var(--text-light);
  }

  .whatsapp-button {
    display: inline-block;
    background: #25d366;
    color: white;
    padding: 1rem 2rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-size: 1.125rem;
    font-weight: 600;
    transition: all 0.2s;
  }

  .whatsapp-button:hover {
    background: #20ba5a;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
  }

  .email-contact {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--text-light);
  }

  .email-contact a {
    color: var(--primary);
    text-decoration: none;
  }

  .email-contact a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .job-header {
      padding: 1.5rem;
    }

    .job-title {
      font-size: 1.5rem;
    }

    .job-meta {
      flex-direction: column;
      gap: 0.5rem;
    }

    .job-content {
      padding: 1.5rem;
    }

    .job-section h2 {
      font-size: 1.25rem;
    }

    .apply-section {
      padding: 1.5rem;
    }

    .whatsapp-button {
      width: 100%;
      padding: 1rem;
    }
  }
</style>
