---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getJobByID, getWhatsAppLink } from '../../lib/payload';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/');
}

let job;
let error = null;

try {
  job = await getJobByID(id);
} catch (e) {
  error = e instanceof Error ? e.message : 'Job not found';
}

if (error || !job) {
  return Astro.redirect('/');
}

const jobTypeLabels: Record<string, string> = {
  bar: 'BAR STAFF',
  kitchen: 'KITCHEN',
  delivery: 'DELIVERY',
  cleaning: 'CLEANING',
  warehouse: 'WAREHOUSE',
  event: 'EVENT STAFF',
  other: 'WORK',
};

const jobTypeLabel = jobTypeLabels[job.jobType as string] || job.jobType;

// Format date
const createdDate = new Date(job.createdAt);
const formattedDate = createdDate.toLocaleDateString('de-DE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const whatsappLink = getWhatsAppLink(job.contactWhatsApp, job.title);

// Simple function to render rich text (Slate format)
function renderRichText(content: any): string {
  if (!content || !Array.isArray(content)) return '';

  return content.map((node: any) => {
    if (node.type === 'paragraph' || !node.type) {
      const text = node.children?.map((child: any) => child.text || '').join('') || '';
      return `<p>${text}</p>`;
    }
    if (node.type === 'ul') {
      const items = node.children?.map((item: any) => {
        const text = item.children?.[0]?.children?.map((child: any) => child.text || '').join('') || '';
        return `<li>${text}</li>`;
      }).join('') || '';
      return `<ul>${items}</ul>`;
    }
    return '';
  }).join('');
}

const descriptionHTML = renderRichText(job.description);
---

<BaseLayout title={`${job.title} - Munich Minijobs`} description={`${job.title} in ${job.district}. €${job.hourlyRate}/hr, ${job.hoursPerWeek}`}>
  <div class="container">
    <a href="/" class="back-link">← ALL JOBS</a>

    <article class="job-detail">
      <header class="job-header">
        <div class="corner-pin"></div>
        <div class="corner-pin-right"></div>
        <span class="job-type-badge">{jobTypeLabel}</span>
        <h1 class="job-title">{job.title.toUpperCase()}</h1>
        <div class="divider"></div>
        <div class="job-meta">
          <div class="meta-row">
            <span class="meta-label">LOCATION:</span>
            <span class="meta-value">{job.district}</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">PAY:</span>
            <span class="meta-value">€{job.hourlyRate}/HR</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">HOURS:</span>
            <span class="meta-value">{job.hoursPerWeek}</span>
          </div>
        </div>
      </header>

      <div class="job-content">
        <section class="job-section">
          <h2>/// DESCRIPTION</h2>
          <div class="description" set:html={descriptionHTML}></div>
        </section>

        {job.address && (
          <section class="job-section">
            <h2>/// EXACT LOCATION</h2>
            <p class="address">{job.address}</p>
          </section>
        )}

        <section class="job-section apply-section">
          <div class="urgent-banner">
            ★ APPLY NOW ★
          </div>
          <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="whatsapp-button">
            APPLY VIA WHATSAPP →
          </a>
          {job.contactEmail && (
            <div class="alt-contact">
              <span>OR EMAIL:</span>
              <a href={`mailto:${job.contactEmail}`}>{job.contactEmail}</a>
            </div>
          )}
        </section>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    color: var(--ink);
    background: var(--neon-yellow);
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    margin-bottom: 2rem;
    font-weight: 700;
    border: var(--border-thin) solid var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.875rem;
    transition: all 0.1s;
  }

  .back-link:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .job-detail {
    background: var(--chalk);
    border: var(--border-thick) solid var(--ink);
    box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.2);
    position: relative;
  }

  .job-header {
    background: var(--chalk);
    border-bottom: var(--border-thick) dashed var(--concrete);
    padding: 3rem 2rem 2rem;
    position: relative;
  }

  .corner-pin {
    position: absolute;
    top: -10px;
    left: 10%;
    width: 16px;
    height: 16px;
    background: var(--concrete);
    border: 2px solid var(--ink);
    transform: rotate(45deg);
    z-index: 10;
  }

  .corner-pin-right {
    position: absolute;
    top: -10px;
    right: 10%;
    width: 16px;
    height: 16px;
    background: var(--concrete);
    border: 2px solid var(--ink);
    transform: rotate(45deg);
    z-index: 10;
  }

  .job-type-badge {
    display: inline-block;
    background: var(--ink);
    color: var(--neon-yellow);
    padding: 0.5rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    border: var(--border-thin) solid var(--ink);
    letter-spacing: 0.1em;
    transform: rotate(-2deg);
  }

  .job-title {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--ink);
    line-height: 1;
    letter-spacing: -0.02em;
    word-wrap: break-word;
  }

  .divider {
    height: 4px;
    background: var(--ink);
    margin-bottom: 1.5rem;
  }

  .job-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .meta-row {
    display: flex;
    gap: 1rem;
    font-family: 'Space Mono', monospace;
    font-size: 1rem;
  }

  .meta-label {
    font-weight: 700;
    min-width: 100px;
  }

  .meta-value {
    font-weight: 400;
  }

  .job-content {
    padding: 2rem;
  }

  .job-section {
    margin-bottom: 3rem;
  }

  .job-section:last-child {
    margin-bottom: 0;
  }

  .job-section h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--ink);
    font-family: 'Space Mono', monospace;
    letter-spacing: 0.05em;
    border-left: 6px solid var(--ink);
    padding-left: 1rem;
  }

  .description :global(p) {
    margin-bottom: 1.25rem;
    line-height: 1.6;
    font-size: 1.125rem;
  }

  .description :global(ul) {
    margin-left: 2rem;
    margin-bottom: 1.25rem;
  }

  .description :global(li) {
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .address {
    font-size: 1.25rem;
    font-weight: 700;
    font-family: 'Space Mono', monospace;
  }

  .apply-section {
    background: var(--concrete);
    padding: 2.5rem 2rem;
    border: var(--border-thick) solid var(--ink);
    text-align: center;
    margin-top: 3rem;
  }

  .urgent-banner {
    background: var(--graffiti);
    color: var(--chalk);
    padding: 0.75rem 2rem;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.2em;
    margin-bottom: 2rem;
    border: var(--border-thin) solid var(--ink);
    display: inline-block;
    animation: pulse 2s infinite;
  }

  .whatsapp-button {
    display: inline-block;
    background: #25d366;
    color: var(--chalk);
    padding: 1.25rem 2.5rem;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 700;
    border: var(--border-thick) solid var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.1s;
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.3);
  }

  .whatsapp-button:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 rgba(0, 0, 0, 0.4);
  }

  .alt-contact {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--chalk);
    font-family: 'Space Mono', monospace;
  }

  .alt-contact span {
    font-weight: 700;
    margin-right: 0.5rem;
  }

  .alt-contact a {
    color: var(--neon-yellow);
    text-decoration: underline;
    font-weight: 700;
  }

  .alt-contact a:hover {
    background: var(--neon-yellow);
    color: var(--ink);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .job-header {
      padding: 2rem 1.5rem 1.5rem;
    }

    .job-title {
      font-size: 2rem;
    }

    .job-meta {
      gap: 0.5rem;
    }

    .meta-row {
      font-size: 0.875rem;
    }

    .meta-label {
      min-width: 85px;
    }

    .job-content {
      padding: 1.5rem;
    }

    .job-section h2 {
      font-size: 1rem;
      padding-left: 0.75rem;
      border-left-width: 4px;
    }

    .description :global(p) {
      font-size: 1rem;
    }

    .apply-section {
      padding: 2rem 1.5rem;
    }

    .whatsapp-button {
      width: 100%;
      padding: 1.125rem 1.5rem;
      font-size: 1.125rem;
    }

    .urgent-banner {
      font-size: 0.875rem;
      padding: 0.625rem 1.5rem;
    }
  }
</style>
