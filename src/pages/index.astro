---
import BaseLayout from '../layouts/BaseLayout.astro';
import JobCard from '../components/JobCard.astro';
import { getJobs } from '../lib/payload';

// Get query parameters for filtering
const url = Astro.url;
const jobType = url.searchParams.get('jobType') || undefined;
const district = url.searchParams.get('district') || undefined;

// Fetch jobs from Payload CMS
let jobs;
let error = null;

try {
  const response = await getJobs({
    limit: 50,
    jobType,
    district,
  });
  jobs = response.docs;
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load jobs';
  jobs = [];
}
---

<BaseLayout title="Munich Minijobs - Find Your Next Job">
  <div class="container">
    <div class="hero">
      <div class="hero-stamp">WORK AVAILABLE</div>
      <h1>MUNICH<br/>MINIJOBS</h1>
      <p class="hero-tagline">/// BAR • KITCHEN • DELIVERY • MORE ///</p>
    </div>

    <div class="filters">
      <form method="get" class="filter-form">
        <div class="filter-group">
          <label for="jobType">Job Type</label>
          <select name="jobType" id="jobType">
            <option value="">All Types</option>
            <option value="bar" selected={jobType === 'bar'}>Bar Staff</option>
            <option value="kitchen" selected={jobType === 'kitchen'}>Kitchen Helper</option>
            <option value="delivery" selected={jobType === 'delivery'}>Delivery</option>
            <option value="cleaning" selected={jobType === 'cleaning'}>Cleaning</option>
            <option value="warehouse" selected={jobType === 'warehouse'}>Warehouse</option>
            <option value="event" selected={jobType === 'event'}>Event Staff</option>
            <option value="other" selected={jobType === 'other'}>Other</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="district">District</label>
          <select name="district" id="district">
            <option value="">All Districts</option>
            <option value="altstadt-lehel" selected={district === 'altstadt-lehel'}>Altstadt-Lehel</option>
            <option value="ludwigsvorstadt-isarvorstadt" selected={district === 'ludwigsvorstadt-isarvorstadt'}>Ludwigsvorstadt-Isarvorstadt</option>
            <option value="maxvorstadt" selected={district === 'maxvorstadt'}>Maxvorstadt</option>
            <option value="schwabing-west" selected={district === 'schwabing-west'}>Schwabing-West</option>
            <option value="au-haidhausen" selected={district === 'au-haidhausen'}>Au-Haidhausen</option>
            <option value="sendling" selected={district === 'sendling'}>Sendling</option>
            <option value="neuhausen-nymphenburg" selected={district === 'neuhausen-nymphenburg'}>Neuhausen-Nymphenburg</option>
            <option value="giesing" selected={district === 'giesing'}>Giesing</option>
            <option value="bogenhausen" selected={district === 'bogenhausen'}>Bogenhausen</option>
            <option value="pasing-obermenzing" selected={district === 'pasing-obermenzing'}>Pasing-Obermenzing</option>
          </select>
        </div>

        <button type="submit" class="filter-button">Filter</button>
        {(jobType || district) && (
          <a href="/" class="clear-button">Clear</a>
        )}
      </form>
    </div>

    {error && (
      <div class="error-message">
        <p>⚠️ {error}</p>
        <p class="error-hint">Make sure Payload CMS is running on port 3000</p>
      </div>
    )}

    {!error && jobs.length === 0 && (
      <div class="no-jobs">
        <p>No jobs found matching your criteria.</p>
        <a href="/">Clear filters</a>
      </div>
    )}

    <div class="jobs-grid">
      {jobs.map((job) => (
        <JobCard job={job} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    margin-bottom: 3rem;
    padding: 3rem 1rem;
    background: var(--chalk);
    border: var(--border-thick) solid var(--ink);
    box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.2);
    position: relative;
  }

  .hero-stamp {
    display: inline-block;
    background: var(--graffiti);
    color: var(--chalk);
    padding: 0.5rem 1.5rem;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.2em;
    transform: rotate(-3deg);
    margin-bottom: 1rem;
    border: var(--border-thin) solid var(--ink);
  }

  .hero h1 {
    font-size: 4rem;
    font-weight: 700;
    line-height: 0.9;
    margin-bottom: 1rem;
    color: var(--ink);
    letter-spacing: -0.05em;
    text-shadow: 4px 4px 0 var(--neon-yellow);
  }

  .hero-tagline {
    font-size: 1rem;
    font-family: 'Space Mono', monospace;
    color: var(--concrete);
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  .filters {
    background: var(--concrete);
    padding: 2rem;
    border: var(--border-thick) solid var(--ink);
    margin-bottom: 3rem;
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.2);
  }

  .filter-form {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: flex-end;
  }

  .filter-group {
    flex: 1;
    min-width: 200px;
  }

  .filter-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--chalk);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .filter-group select {
    width: 100%;
    padding: 0.875rem;
    border: var(--border-thin) solid var(--ink);
    font-size: 1rem;
    background: var(--chalk);
    font-weight: 600;
    font-family: 'Space Grotesk', sans-serif;
    cursor: pointer;
  }

  .filter-group select:focus {
    outline: var(--border-thick) solid var(--neon-yellow);
    outline-offset: 2px;
  }

  .filter-button {
    padding: 0.875rem 2rem;
    background: var(--neon-yellow);
    color: var(--ink);
    border: var(--border-thin) solid var(--ink);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.1s;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .filter-button:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .clear-button {
    padding: 0.875rem 1.5rem;
    background: transparent;
    color: var(--chalk);
    border: var(--border-thin) solid var(--chalk);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    transition: all 0.1s;
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .clear-button:hover {
    background: var(--graffiti);
    border-color: var(--graffiti);
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .jobs-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  .error-message {
    background: var(--chalk);
    border: var(--border-thick) solid var(--graffiti);
    color: var(--ink);
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: 6px 6px 0 rgba(255, 0, 110, 0.2);
  }

  .error-message p {
    font-weight: 700;
    font-size: 1.125rem;
  }

  .error-hint {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-family: 'Space Mono', monospace;
    opacity: 0.7;
  }

  .no-jobs {
    text-align: center;
    padding: 4rem 1rem;
    background: var(--chalk);
    border: var(--border-thick) solid var(--ink);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.2);
  }

  .no-jobs p {
    font-weight: 700;
    font-size: 1.25rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .no-jobs a {
    display: inline-block;
    margin-top: 1rem;
    color: var(--chalk);
    background: var(--ink);
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    font-weight: 700;
    border: var(--border-thin) solid var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.1s;
  }

  .no-jobs a:hover {
    background: var(--graffiti);
    border-color: var(--graffiti);
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--ink);
  }

  @media (min-width: 768px) {
    .jobs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2rem 1rem;
    }

    .hero h1 {
      font-size: 2.5rem;
      text-shadow: 3px 3px 0 var(--neon-yellow);
    }

    .hero-tagline {
      font-size: 0.75rem;
    }

    .filters {
      padding: 1.5rem;
    }

    .filter-form {
      flex-direction: column;
    }

    .filter-group {
      width: 100%;
    }

    .filter-button,
    .clear-button {
      width: 100%;
    }

    .jobs-grid {
      gap: 1.5rem;
    }
  }
</style>
