# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/munich-job-board

# Payload CMS secret key (generate a random string for production)
PAYLOAD_SECRET=your-secret-key-change-in-production

# Payload API URL (used by Astro to fetch data)
PAYLOAD_API_URL=http://localhost:3000/api

# Use mock data instead of Payload API (set to 'true' for demo without database)
# Leave commented out or set to 'false' to use real Payload CMS
# USE_MOCK_DATA=true
